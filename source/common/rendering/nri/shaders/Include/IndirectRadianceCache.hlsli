#ifndef NRI_INDIRECT_RADIANCE_CACHE_HLSLI
#define NRI_INDIRECT_RADIANCE_CACHE_HLSLI

#define NRI_INDIRECT_RADIANCE_CACHE_RECORD_STRIDE 48
#define NRI_INDIRECT_RADIANCE_CACHE_TELEMETRY_COUNT 16
#define NRI_INDIRECT_RADIANCE_CACHE_TELEMETRY_LOOKUPS 0
#define NRI_INDIRECT_RADIANCE_CACHE_TELEMETRY_FORCED_MISSES 1
#define NRI_INDIRECT_RADIANCE_CACHE_TELEMETRY_COLLISIONS 2
#define NRI_INDIRECT_RADIANCE_CACHE_TELEMETRY_STALE_GENERATION 3
#define NRI_INDIRECT_RADIANCE_CACHE_TELEMETRY_UNSUPPORTED_ROUTE 4
#define NRI_INDIRECT_RADIANCE_CACHE_TELEMETRY_EXACT_FALLBACK 5
#define NRI_INDIRECT_RADIANCE_CACHE_TELEMETRY_OCCUPANCY 6
#define NRI_INDIRECT_RADIANCE_CACHE_TELEMETRY_UPDATES 7
#define NRI_INDIRECT_RADIANCE_CACHE_TELEMETRY_CLEAR_COUNT 8
#define NRI_INDIRECT_RADIANCE_CACHE_TELEMETRY_LOOKUP_TIME 9
#define NRI_INDIRECT_RADIANCE_CACHE_TELEMETRY_UPDATE_TIME 10
#define NRI_INDIRECT_RADIANCE_CACHE_TELEMETRY_RESOLVE_TIME 11
#define NRI_INDIRECT_RADIANCE_CACHE_TELEMETRY_CLEAR_TIME 12
#define NRI_INDIRECT_RADIANCE_CACHE_TELEMETRY_ACCEPTED_HITS 13

struct IndirectRadianceCacheRecord
{
	uint2 StableKey;
	uint2 Compatibility;
	uint2 QuantizedWorldPosition;
	uint PackedNormalAndRoute;
	uint MaterialFlags;
	float3 IncidentRadiance;
	uint Metadata;
};

RWStructuredBuffer<IndirectRadianceCacheRecord> gIndirectRadianceCachePrevious : register(u0, space6);
RWStructuredBuffer<IndirectRadianceCacheRecord> gIndirectRadianceCacheCurrent : register(u1, space6);
RWStructuredBuffer<uint> gIndirectRadianceCacheTelemetry : register(u2, space6);

#endif
