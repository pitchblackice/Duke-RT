{
  "name": "smoke-e1l1-four-map-step0-d3d12",
  "backend": "d3d12",
  "description": "Matched Step 0 compact capture after four authored E1L1 map emitters reach a settled sparse-grid workload.",
  "limitations": [
    "The fixed spawn camera measures the authored E1L1 state without scripted camera rotation; behind-camera and occlusion variants remain separate follow-up scenarios.",
    "Ordinary PNG screenshots are inspected separately because this checkout has no linear-HDR capture command."
  ],
  "commands": "+wait 45; map e1l1; wait 1; closemenu; wait 300; perf_compactframes 192",
  "capture": {
    "loopTraceFrames": 192,
    "timeoutSeconds": 300,
    "runs": 3,
    "stopWhenLoopTraceFramesCaptured": false,
    "stopWhenPrefix": "PERF compact capture complete:",
    "stopWhenPrefixCount": 1
  },
  "launch": {
    "file": "M:/Raze/full-voxel-overlay",
    "gameGrp": "C:/Program Files (x86)/Steam/steamapps/common/Duke Nukem 3D Twentieth Anniversary World Tour/DUKE3D.GRP",
    "extraArgs": [
      "-nosound", "-nologo",
      "+set", "vid_defwidth", "1920", "+set", "vid_defheight", "1080",
      "+set", "nri_ptwaitpresent", "false",
      "+set", "nri_validation", "false",
      "+set", "nri_apivalidation", "false",
      "+set", "nri_dred", "true",
      "+set", "nri_ptgputiming", "true",
      "+set", "nri_ptshaderstats", "false",
      "+set", "nri_ptlightbounces", "2", "+set", "nri_ptmirrorbounces", "2",
      "+set", "nri_ptportaldepth", "3", "+set", "nri_ptemissivesamples", "1",
      "+set", "nri_ptemissiveprimarybudget", "2", "+set", "nri_ptvoxelblaspolicy", "3",
      "+set", "nri_ptvoxelshadowproxybuild", "false", "+set", "nri_ptvoxelshadowproxyroute", "false",
      "+set", "nri_ptindirectradiancecache", "false", "+set", "nri_ptindirectradiancecacheaccept", "false",
      "+set", "nri_ptsmoke", "true",
      "+set", "nri_ptsmokerepresentation", "1",
      "+set", "nri_ptsmokereadback", "true",
      "+set", "nri_ptsmokedirectreference", "1",
      "+set", "nri_ptsmokegridbricks", "512", "+set", "nri_ptsmokegridcellsize", "8",
      "+set", "nri_ptsmokeworldpartitions", "1", "+set", "nri_ptsmokeworldnewcells", "8192",
      "+set", "nri_ptsmokeworldmaintenancecells", "32768", "+set", "nri_ptsmokeworldradiancemaxage", "16",
      "+set", "nri_pttraceframes", "0",
      "+set", "nri_ptslowdowntrace", "false",
      "+set", "nri_ptloadingtrace", "0",
      "+set", "nri_ptscenestats", "false",
      "+set", "nri_voxelstats", "false"
    ]
  },
  "requiredPrefixes": [
    "PERF loop trace:",
    "PERF pt gpu timing NRI:",
    "PERF pt smoke work NRI:",
    "PERF compact capture complete:"
  ],
  "forbiddenPatterns": [
    "status=aborted",
    "Device removed",
    "device lost",
    "DXGI_ERROR_DEVICE",
    "QueueSubmit failed",
    "QueuePresent failed",
    "AcquireNextTexture(): failed",
    "NRI render failed",
    "validation error",
    "failed to create",
    "assertion failed",
    "fatal error",
    "DRED after",
    "DRED breadcrumb",
    "DRED page fault",
    "DRED page-fault",
    "DeviceRemovedExtendedData"
  ],
  "baselineCompare": {
    "allowRelativeRegressionPercent": 10.0,
    "fieldMetrics": [ "avg", "p50", "p95", "p99", "max" ],
    "loopTraceMetrics": [ "p50", "p95", "p99", "max", "framesOver50", "framesOver100", "framesOver200" ],
    "fields": [
      "PERF loop trace/frame_ms",
      "PERF pt gpu timing NRI/segment",
      "PERF pt gpu timing NRI/smoke_grid_allocate",
      "PERF pt gpu timing NRI/smoke_grid_deposit",
      "PERF pt gpu timing NRI/smoke_grid_simulate",
      "PERF pt gpu timing NRI/smoke_grid_rebuild",
      "PERF pt gpu timing NRI/smoke_world_active",
      "PERF pt gpu timing NRI/smoke_world_link",
      "PERF pt gpu timing NRI/smoke_world_proposal",
      "PERF pt gpu timing NRI/smoke_world_seed",
      "PERF pt gpu timing NRI/smoke_world_temporal",
      "PERF pt gpu timing NRI/smoke_materialize",
      "PERF pt gpu timing NRI/smoke_view_direct",
      "PERF pt gpu timing NRI/smoke_integrate",
      "PERF pt gpu timing NRI/smoke_reconstruction",
      "PERF pt gpu timing NRI/invalid",
      "PERF pt gpu timing NRI/dropped",
      "PERF pt smoke work NRI/grid_resident",
      "PERF pt smoke work NRI/grid_allocation_failures",
      "PERF pt smoke work NRI/world_active",
      "PERF pt smoke work NRI/world_source_density",
      "PERF pt smoke work NRI/world_link_rays",
      "PERF pt smoke work NRI/view_occupied",
      "PERF pt smoke work NRI/view_directional_shadow_rays",
      "PERF pt smoke work NRI/view_direct_receiver_samples"
    ]
  }
}
