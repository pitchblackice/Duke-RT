{
  "name": "large-voxel-frustum-d3d12",
  "backend": "d3d12",
  "description": "User save facing a large voxel-heavy view. This save is also near fire/bloom content.",
  "save": {
    "dir": "M:/Raze/tools/perf-saves/Duke.WorldTour",
    "name": "largevoxel01",
    "settleTics": 35,
    "warmupTics": 35
  },
  "capture": {
    "loopTraceFrames": 256,
    "timeoutSeconds": 180,
    "runs": 3,
    "stopWhenLoopTraceFramesCaptured": true
  },
  "launch": {
    "file": "M:/Raze/full-voxel-overlay",
    "gameGrp": "C:/Program Files (x86)/Steam/steamapps/common/Duke Nukem 3D Twentieth Anniversary World Tour/DUKE3D.GRP",
    "extraArgs": [
      "+set", "nri_ptbloom", "true"
    ]
  },
  "requiredPrefixes": [
    "PERF loop trace:",
    "PERF render trace NRI:",
    "PERF pt shell trace NRI:"
  ],
  "baselineCompare": {
    "allowRelativeRegressionPercent": 15.0,
    "fields": [
      "PERF loop trace/frame_ms",
      "PERF render trace NRI/total",
      "PERF render trace NRI/as",
      "PERF pt shell trace NRI/select",
      "PERF pt overlay append sources NRI/persistent_voxel_bytes"
    ]
  }
}
