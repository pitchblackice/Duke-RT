{
  "name": "smoke-e1l5-one-plume-step0-d3d12",
  "backend": "d3d12",
  "description": "Step 0 fixed-camera single synthetic plume timing and work capture.",
  "commands": "+wait 45; map e1l5; wait 1; closemenu; wait 30; nri_ptsmoke_test; wait 120; perf_compactframes 192",
  "capture": {
    "loopTraceFrames": 192,
    "timeoutSeconds": 300,
    "runs": 3,
    "stopWhenLoopTraceFramesCaptured": false,
    "stopWhenPrefix": "PERF compact capture complete:",
    "stopWhenPrefixCount": 1
  },
  "launch": {
    "file": "M:/Raze/full-voxel-overlay",
    "gameGrp": "C:/Program Files (x86)/Steam/steamapps/common/Duke Nukem 3D Twentieth Anniversary World Tour/DUKE3D.GRP",
    "extraArgs": [
      "-nosound", "-nologo",
      "+set", "vid_defwidth", "1920", "+set", "vid_defheight", "1080",
      "+set", "nri_ptwaitpresent", "false",
      "+set", "nri_ptgputiming", "true",
      "+set", "nri_ptlightbounces", "2", "+set", "nri_ptmirrorbounces", "2",
      "+set", "nri_ptportaldepth", "3", "+set", "nri_ptemissivesamples", "1",
      "+set", "nri_ptemissiveprimarybudget", "2", "+set", "nri_ptvoxelblaspolicy", "3",
      "+set", "nri_ptvoxelshadowproxybuild", "false", "+set", "nri_ptvoxelshadowproxyroute", "false",
      "+set", "nri_ptindirectradiancecache", "false", "+set", "nri_ptindirectradiancecacheaccept", "false",
      "+set", "nri_ptsmoke", "true",
      "+set", "nri_ptsmokerepresentation", "1",
      "+set", "nri_ptsmokereadback", "true",
      "+set", "nri_ptsmokedirectreference", "1",
      "+set", "nri_pttraceframes", "0",
      "+set", "nri_ptloadingtrace", "0"
    ]
  },
  "requiredPrefixes": [
    "PERF loop trace:",
    "PERF pt gpu timing NRI:",
    "PERF pt smoke work NRI:",
    "PERF compact capture complete:"
  ],
  "forbiddenPatterns": [
    "status=aborted", "Device removed", "device lost", "DXGI_ERROR_DEVICE",
    "QueueSubmit failed", "QueuePresent failed", "AcquireNextTexture(): failed",
    "NRI render failed", "validation error", "failed to create", "assertion failed", "fatal error"
  ]
}
