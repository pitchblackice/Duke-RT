{
  "name": "compute-voxel-runtime-tail-e3l10-d3d12",
  "backend": "d3d12",
  "description": "E3L10 cold runtime-tail control: preload raw sources plus all material dependencies, but withhold every optional-only mesh/BLAS through the stable mesh-resource partition.",
