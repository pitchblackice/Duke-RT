# Additive preload overlay for the E5L4 warmed perf lane.
#
# Mount after M:/Raze/full-voxel-overlay. This intentionally does not replace
# the base overlay's VOXELPRELOAD; the loader reads every mounted VOXELPRELOAD
# lump and merges duplicate requests.

VOXELPRELOAD

map E5L4

