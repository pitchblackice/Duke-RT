{
  "name": "as-opening-d3d12-beauty-e2l4",
  "backend": "d3d12",
  "map": "e2l4",
  "debugMode": 0,
  "traceFrames": 96,
  "captureWhenPassed": true,
  "minSelfTestFrames": 16,
  "commands": "+wait 45; map e2l4; wait 1; closemenu; wait 10; perf_looptraceframes 128",
  "requiredPrefixes": [
    "NRI PT selftest:",
    "NRI PT frame boundary:"
  ],
  "forbiddenPatterns": [
    "Device removed",
    "device lost",
    "validation error",
    "failed to create",
    "assertion failed",
    "NRI BeginCommandList blocked",
    "NRI SubmitWaitAndRestartCommandList failed"
  ],
  "baselinePrefixes": [
    "PERF pt as model NRI:",
    "PERF pt as reuse NRI:",
    "PERF pt world tlas detail NRI:",
    "PERF pt scene record audit NRI:",
    "PERF pt hit metadata NRI:"
  ],
  "prefixAssertions": [
    {
      "prefix": "PERF pt as model NRI:",
      "minCount": 1,
      "applyTo": "all",
      "fields": {
        "world_tlas_objects": { "exact": 1 },
        "world_tlas_entries": { "min": 1 },
        "blas_static": { "min": 1 },
        "scene_records": { "min": 1 }
      },
      "relations": [
        { "left": "world_tlas_entries", "operator": "eq", "rightField": "scene_records" }
      ]
    },
    {
      "prefix": "PERF pt as reuse NRI:",
      "minCount": 1,
      "applyTo": "all",
      "fields": {
        "static_chunk_owned_blas": { "min": 1 },
        "static_segment_blas": { "exact": 0 }
      }
    },
    {
      "prefix": "PERF pt world tlas detail NRI:",
      "minCount": 1,
      "applyTo": "all",
      "fields": {
        "calls": { "exact": 1 },
        "instances": { "min": 1 },
        "creates": { "exact": 1 }
      }
    },
    {
      "prefix": "PERF pt scene record audit NRI:",
      "minCount": 1,
      "applyTo": "all",
      "fields": {
        "records": { "min": 1 },
        "invalid_source": { "exact": 0 },
        "legacy_compatible": { "min": 1 }
      }
    },
    {
      "prefix": "PERF pt hit metadata NRI:",
      "minCount": 1,
      "applyTo": "all",
      "fields": {
        "records": { "min": 1 },
        "primitive_base_mismatches": { "exact": 0 },
        "material_base_mismatches": { "exact": 0 }
      }
    }
  ]
}
