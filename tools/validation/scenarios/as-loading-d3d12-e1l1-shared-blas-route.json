{
  "name": "as-loading-d3d12-e1l1-shared-blas-route",
  "backend": "d3d12",
  "map": "e1l1",
  "debugMode": 0,
  "traceFrames": 160,
  "captureWhenPassed": true,
  "minSelfTestFrames": 16,
  "commands": "+wait 45; map e1l1; wait 1; closemenu; wait 10; perf_looptraceframes 192",
  "requiredPrefixes": [
    "NRI PT loading summary:",
    "NRI PT preload ready:",
    "NRI PT loading voxel shared blas:",
    "NRI PT selftest:",
    "NRI PT frame boundary:"
  ],
  "forbiddenPatterns": [
    "Device removed",
    "device lost",
    "validation error",
    "failed to create",
    "assertion failed",
    "NRI BeginCommandList blocked",
    "NRI SubmitWaitAndRestartCommandList failed"
  ],
  "extraArgs": [
    "+set",
    "nri_ptloadingtrace",
    "2",
    "+set",
    "nri_ptvoxelsharedblasbuild",
    "true",
    "+set",
    "nri_ptvoxelsharedblasbuilds",
    "32",
    "+set",
    "nri_ptvoxelsharedblasloading",
    "true",
    "+set",
    "nri_ptvoxelsharedblasroute",
    "true"
  ],
  "loadingAssertions": {
    "requirePreloadReady": true,
    "forbidFrameTargetWait": true,
    "requireStandaloneContext": true,
    "maxStartupCorrectionPendingAtReady": 0,
    "maxRequiredVoxelPendingAtReady": 0,
    "maxFirstFrameRuntimeVoxelAdmissions": 0,
    "maxFirstFrameStaticSceneBuilds": 0,
    "maxFirstFrameTexturePrewarmDefers": 0
  },
  "prefixAssertions": [
    {
      "prefix": "NRI PT loading voxel shared blas:",
      "minCount": 1,
      "applyTo": "first",
      "fields": {
        "unique_keys": { "min": 1 },
        "resident_after": { "min": 1 },
        "built": { "min": 1 },
        "reject_budget": { "exact": 0 },
        "reject_geometry_mismatch": { "exact": 0 }
      }
    },
    {
      "prefix": "PERF pt as model NRI:",
      "minCount": 1,
      "applyTo": "all",
      "fields": {
        "world_tlas_objects": { "exact": 1 },
        "world_tlas_entries": { "min": 1 },
        "blas_static": { "min": 1 },
        "entries_voxel": { "min": 1 },
        "scene_records": { "min": 1 }
      },
      "relations": [
        { "left": "world_tlas_entries", "operator": "eq", "rightField": "scene_records" }
      ]
    },
    {
      "prefix": "PERF pt scene record audit NRI:",
      "minCount": 1,
      "applyTo": "all",
      "fields": {
        "records": { "min": 1 },
        "invalid_source": { "exact": 0 },
        "material_indirection": { "min": 1 }
      }
    },
    {
      "prefix": "PERF pt hit metadata NRI:",
      "minCount": 1,
      "applyTo": "all",
      "fields": {
        "records": { "min": 1 },
        "primitive_base_mismatches": { "exact": 0 },
        "material_base_mismatches": { "exact": 0 },
        "persistent_material_base_records": { "min": 1 }
      }
    },
    {
      "prefix": "PERF pt voxel shared blas NRI:",
      "minCount": 1,
      "applyTo": "first",
      "fields": {
        "active_actors": { "min": 1 },
        "unique_desired_keys": { "min": 1 },
        "resident_shared_assets": { "min": 1 },
        "build_attempts": { "exact": 0 },
        "cache_hits": { "min": 1 },
        "routed_shared": { "min": 1 },
        "route_eligible_actors": { "min": 1 },
        "route_reject_missing_resident": { "exact": 0 },
        "reject_missing_key": { "exact": 0 }
      }
    }
  ]
}
