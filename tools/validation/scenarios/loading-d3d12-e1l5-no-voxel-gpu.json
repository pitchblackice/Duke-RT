{
  "name": "loading-d3d12-e1l5-no-voxel-gpu",
  "backend": "d3d12",
  "map": "e1l5",
  "debugMode": 0,
  "traceFrames": 96,
  "captureWhenPassed": true,
  "minSelfTestFrames": 16,
  "commands": "+wait 45; map e1l5; wait 1; closemenu",
  "requiredPrefixes": [
    "NRI PT loading summary:",
    "NRI PT preload ready:",
    "NRI PT selftest:",
    "NRI PT frame boundary:"
  ],
  "forbiddenPatterns": [
    "Device removed",
    "device_lost",
    "validation error",
    "failed to create",
    "assertion failed",
    "NRI BeginCommandList blocked",
    "NRI SubmitWaitAndRestartCommandList failed"
  ],
  "extraArgs": [
    "+set",
    "nri_ptloadingtrace",
    "2",
    "+set",
    "nri_ptloadingvoxelgpu",
    "false"
  ],
  "loadingAssertions": {
    "requirePreloadReady": true,
    "forbidFrameTargetWait": true,
    "requireStandaloneContext": true,
    "maxStartupCorrectionPendingAtReady": 0,
    "maxRequiredVoxelPendingAtReady": 0,
    "maxFirstFrameStaticSceneBuilds": 0
  }
}
