{
  "name": "as-opening-d3d12-e1l1-dynamic-overlay-blas-gates",
  "backend": "d3d12",
  "map": "e1l1",
  "debugMode": 0,
  "traceFrames": 128,
  "captureWhenPassed": true,
  "minSelfTestFrames": 16,
  "commands": "+wait 45; map e1l1; wait 1; closemenu; wait 10; perf_looptraceframes 160",
  "requiredPrefixes": [
    "NRI PT selftest:",
    "NRI PT frame boundary:"
  ],
  "forbiddenPatterns": [
    "Device removed",
    "device lost",
    "validation error",
    "failed to create",
    "assertion failed",
    "NRI BeginCommandList blocked",
    "NRI SubmitWaitAndRestartCommandList failed"
  ],
  "extraArgs": [
    "+set",
    "nri_ptdynamicoverlayblasbuild",
    "true",
    "+set",
    "nri_ptdynamicoverlayblasroute",
    "true",
    "+set",
    "nri_ptdynamicoverlayblasbuilds",
    "2"
  ],
  "prefixAssertions": [
    {
      "prefix": "PERF pt dynamic overlay blas NRI:",
      "minCount": 1,
      "applyTo": "all",
      "fields": {
        "build_enabled": { "exact": 1 },
        "route_enabled": { "exact": 1 },
        "build_budget": { "exact": 2 },
        "prims": { "min": 1 },
        "fallback_prims": { "min": 1 },
        "build_attempts": { "exact": 0 },
        "build_successes": { "exact": 0 },
        "routed_instances": { "exact": 0 },
        "monolithic_refs": { "exact": 1 }
      }
    }
  ]
}
