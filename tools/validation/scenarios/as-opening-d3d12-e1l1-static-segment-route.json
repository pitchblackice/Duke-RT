{
  "name": "as-opening-d3d12-e1l1-static-segment-route",
  "backend": "d3d12",
  "map": "e1l1",
  "debugMode": 0,
  "traceFrames": 128,
  "captureWhenPassed": true,
  "minSelfTestFrames": 16,
  "extraArgs": [
    "+set", "nri_ptstaticsegmentblasbuild", "true",
    "+set", "nri_ptstaticsegmentroute", "true"
  ],
  "commands": "+wait 45; map e1l1; wait 1; closemenu; wait 10; perf_looptraceframes 160",
  "requiredPrefixes": [
    "NRI PT selftest:",
    "NRI PT frame boundary:"
  ],
  "forbiddenPatterns": [
    "Device removed",
    "device lost",
    "validation error",
    "failed to create",
    "assertion failed",
    "NRI BeginCommandList blocked",
    "NRI SubmitWaitAndRestartCommandList failed"
  ],
  "prefixAssertions": [
    {
      "prefix": "PERF pt static segment cache NRI:",
      "minCount": 1,
      "applyTo": "all",
      "fields": {
        "entries": { "min": 1 },
        "resident_blas": { "min": 1 },
        "builds_last_rebuild": { "min": 1 },
        "blas_build_enabled": { "exact": 1 }
      }
    },
    {
      "prefix": "PERF pt static segment route NRI:",
      "minCount": 1,
      "applyTo": "all",
      "fields": {
        "routed_segment": { "min": 1 },
        "chunk_fallback": { "exact": 0 },
        "reject_missing_cache": { "exact": 0 },
        "reject_missing_blas": { "exact": 0 },
        "segment_blas_refs": { "min": 1 },
        "chunk_blas_refs": { "exact": 0 }
      }
    },
    {
      "prefix": "PERF pt as reuse NRI:",
      "minCount": 1,
      "applyTo": "all",
      "fields": {
        "static_chunk_owned_blas": { "min": 1 },
        "static_segment_blas": { "min": 1 }
      }
    }
  ]
}
