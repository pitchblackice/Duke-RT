{
  "name": "as-save-d3d12-explosion-animated-voxel-shared-route",
  "backend": "d3d12",
  "debugMode": 0,
  "traceFrames": 192,
  "captureWhenPassed": true,
  "minSelfTestFrames": 16,
  "save": {
    "dir": "M:/Raze/tools/perf-saves/Duke.WorldTour"
  },
  "commands": "+wait 45; load explosionburst01; wait 35; closemenu; wait 35; perf_looptraceframes 192",
  "requiredPrefixes": [
    "NRI PT selftest:",
    "NRI PT frame boundary:",
    "PERF pt voxel actor state NRI:",
    "PERF pt voxel shared blas NRI:"
  ],
  "forbiddenPatterns": [
    "Device removed",
    "device lost",
    "validation error",
    "failed to create",
    "assertion failed",
    "NRI BeginCommandList blocked",
    "NRI SubmitWaitAndRestartCommandList failed",
    "PERF pt voxel shared key collision NRI"
  ],
  "extraArgs": [
    "+set",
    "nri_voxelstats",
    "false",
    "+set",
    "nri_ptvoxelactorstatetrace",
    "true",
    "+set",
    "nri_ptvoxelactorstatetracelimit",
    "12000",
    "+set",
    "nri_ptvoxelsharedblasbuild",
    "true",
    "+set",
    "nri_ptvoxelsharedblasbuilds",
    "32",
    "+set",
    "nri_ptvoxelsharedblasloading",
    "true",
    "+set",
    "nri_ptvoxelsharedblasroute",
    "true"
  ],
  "prefixAssertions": [
    {
      "prefix": "PERF pt voxel actor state NRI:",
      "minCount": 8,
      "applyTo": "all",
      "groupDistinct": [
        {
          "groupBy": "actor",
          "minGroups": 1,
          "fields": [
            { "field": "pic", "minDistinct": 2, "exclude": [ "-1" ] },
            { "field": "mesh_variant", "minDistinct": 2, "exclude": [ "0x0" ] },
            { "field": "surface_sig", "minDistinct": 2, "exclude": [ "0x0" ] }
          ]
        }
      ]
    },
    {
      "prefix": "NRI PT selftest:",
      "minCount": 1,
      "applyTo": "last",
      "fields": {
        "world_active": { "exact": 1 },
        "voxel_instances": { "min": 1 },
        "scene_instances": { "min": 1 }
      }
    },
    {
      "prefix": "PERF pt voxel shared blas NRI:",
      "minCount": 1,
      "applyTo": "last",
      "fields": {
        "active_actors": { "min": 1 },
        "resident_shared_assets": { "min": 1 },
        "routed_shared": { "min": 1 },
        "route_reject_geometry_mismatch": { "exact": 0 },
        "reject_geometry_mismatch": { "exact": 0 }
      }
    }
  ]
}
