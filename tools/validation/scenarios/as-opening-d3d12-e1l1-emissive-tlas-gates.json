{
  "name": "as-opening-d3d12-e1l1-emissive-tlas-gates",
  "backend": "d3d12",
  "map": "e1l1",
  "debugMode": 0,
  "traceFrames": 128,
  "captureWhenPassed": true,
  "minSelfTestFrames": 16,
  "commands": "+wait 45; map e1l1; wait 1; closemenu; wait 10; perf_looptraceframes 160",
  "requiredPrefixes": [
    "NRI PT selftest:",
    "NRI PT frame boundary:"
  ],
  "forbiddenPatterns": [
    "Device removed",
    "device lost",
    "validation error",
    "failed to create",
    "assertion failed",
    "NRI BeginCommandList blocked",
    "NRI SubmitWaitAndRestartCommandList failed"
  ],
  "extraArgs": [
    "+set",
    "nri_ptemissivetlas",
    "true"
  ],
  "prefixAssertions": [
    {
      "prefix": "PERF pt emissive as model NRI:",
      "minCount": 1,
      "applyTo": "last",
      "fields": {
        "enabled": { "exact": 1 },
        "records": { "min": 1 },
        "mask_other_refs": { "exact": 0 },
        "sampling_output_persistent_voxel": { "exact": 0 }
      }
    }
  ]
}
