# Mounted voxel preload list for the full voxel overlay.
#
# Supported sections:
#   global
#   game <duke|worldtour|shareware|...>
#   map <map-label>
#
# Supported request forms:
#   pic <picnum> [priority=force|high|normal|opportunistic] [gpu=force|prefer|none]
#   picrange <first> <last> [priority=...] [gpu=...]
#   picrange <first>-<last> [priority=...] [gpu=...]
#   actor <ActorClass> picnums=<a,b,c> [priority=...] [gpu=...]
#   actor <ActorClass> picrange=<first>-<last> [priority=...] [gpu=...]
#   actor <ActorClass> allpicnums [priority=...] [gpu=...]
#
# Omitted gpu= means CPU warmup only. gpu=prefer requests loading-screen GPU
# admission when budgets allow, then falls back to the runtime admission queue.

VOXELPRELOAD

global

# Short-lived spawned explosion actor. Keep both the actor-scoped request and
# the direct picrange so this remains robust if actor default resolution changes.
actor DukeExplosion2 picrange=1891-1910 priority=force gpu=prefer reason=spawned-explosion-actor
picrange 1891-1910 priority=force gpu=prefer reason=spawned-explosion-tiles

